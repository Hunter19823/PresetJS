{
  "schemaVersion": 1,
  "id": "presetjs",
  "version": "${version}",
  "name": "PresetJS",
  "description": "A KubeJS Addon for adding additional Presets",
  "authors": [
    "ILIKEPIEFOO2"
  ],
  "contact": {
    "homepage": "https://github.com/Hunter19823/PresetJS",
    "issues": "https://github.com/Hunter19823/PresetJS/issues",
    "sources": "https://github.com/Hunter19823/PresetJS"
  },
  "license": "MIT",
  "icon": "assets/presetjs/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "pie.ilikepiefoo.presetjs.fabric.PresetJSFabric"
    ],
    "client": [
      "pie.ilikepiefoo.presetjs.fabric.client.PresetJSFabricClient"
    ]
  },
  "mixins": [
    "presetjs.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
